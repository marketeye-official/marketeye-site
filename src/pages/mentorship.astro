---
// Paid mentorship overview with retail pricing (quarterly or lifetime); apply via the existing Calendly link.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { ico } from '../lib/icons';

const APPLY = 'https://calendly.com/marketeye/marketeye-applicant';

const faqs = [
  ['How much does the mentorship cost?', 'There are two options: a quarterly membership at $900 every 90 days, or lifetime access for $10,800 plus a $25/month platform fee. We walk through both on your interview call, before you commit to anything.'],
  ['Can I get a refund?', 'Membership charges are non-refundable, and quarterly memberships renew automatically until you cancel. Read the refund policy and cancellation instructions before enrolling.'],
  ['Do I have to finish the free course first?', 'We recommend it. The course covers the foundations the mentorship builds on, and the interview goes better when you know the basics.'],
  ['Will you tell me what to trade?', "No. MarketEye is an education company, not an adviser. Mentors give feedback on whether you're following your own written plan, and nothing we share is a recommendation to buy or sell."],
  ['Do you provide trading capital or funded accounts?', "No. MarketEye doesn't provide, manage or arrange trading capital. Any third-party evaluations come with their own rules and fees, and we aren't affiliated with them."],
  ['How do I cancel?', 'Email support@marketeye.io from the address on your account. Our cancellation instructions page walks through the steps and timing.'],
];

const schema = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })),
}];
---
<BaseLayout
  title="MarketEye Mentorship | Futures Trading Mentorship by Interview"
  description="An optional paid futures trading mentorship for MarketEye community members: live sessions, direct Q&A and process reviews. $900 per quarter or lifetime access. By interview only."
  path="/mentorship"
  schema={schema}
>
  <PageHero
    eyebrow="Mentorship · by interview"
    title="Closer guidance when you're ready to prove your process."
    lede="The free community teaches the foundations. The paid mentorship is for members who've worked through the course and want direct feedback while they prove a written plan in a simulator and work toward trading it on their own."
    image="04-practice-first"
    imageAlt="Hands on a keyboard in front of two monitors with glowing candlestick charts"
  >
    <a href="/#quiz" class="btn" data-cta="mentorship-hero">Start with the free course</a>
    <a href={APPLY} class="btn ghost" data-cta="mentorship-apply-hero">Already a member? Book your interview</a>
  </PageHero>

  <section class="section alt" aria-labelledby="inc-h">
    <div class="wrap stack">
      <div class="head center"><span class="eyebrow">What's included</span><h2 class="h2" id="inc-h">More time with traders who've done it.</h2></div>
      <div class="icon-grid four">
        <div class="card icon-card"><span class="ico" set:html={ico('monitor')} /><h3 class="t3">Live sessions</h3><p class="muted">Regular live sessions and market briefings, with recordings in the archive.</p></div>
        <div class="card icon-card"><span class="ico" set:html={ico('chat')} /><h3 class="t3">Direct mentorship and Q&amp;A</h3><p class="muted">Ask questions and get answers from experienced traders, not a help desk.</p></div>
        <div class="card icon-card"><span class="ico" set:html={ico('clipboard')} /><h3 class="t3">Process reviews</h3><p class="muted">Feedback on whether you followed your own written plan, win or lose.</p></div>
        <div class="card icon-card"><span class="ico" set:html={ico('users')} /><h3 class="t3">Private member workspace</h3><p class="muted">A private Slack community and ClickUp resource hub, plus the full educational archive.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="price-h">
    <div class="wrap stack">
      <div class="head center"><span class="eyebrow">Pricing</span><h2 class="h2" id="price-h">Two ways to join.</h2>
        <p class="lead" style="text-align: center; margin-inline: auto">Both include everything above. You'll go over them on your interview call before you commit to anything.</p></div>
      <div class="price-grid">
        <div class="card price-card">
          <span class="eyebrow">Quarterly</span>
          <div class="price"><b>$900</b><span>every 90 days</span></div>
          <ul class="checks">
            <li><span>Renews automatically every 90 days</span></li>
            <li><span>Cancel by email before your renewal date</span></li>
          </ul>
        </div>
        <div class="card price-card">
          <span class="eyebrow">Lifetime</span>
          <div class="price"><b>$10,800</b><span>one time, plus a $25/month platform fee</span></div>
          <ul class="checks">
            <li><span>Access for as long as the program runs</span></li>
            <li><span>No renewal fee. The only ongoing cost is the platform fee.</span></li>
          </ul>
        </div>
      </div>
      <p class="center-link" style="font-weight: 400; color: var(--muted)">Charges are non-refundable. See the <a href="/membership-billing-terms">billing terms</a>, <a href="/refund-policy">refund policy</a> and <a href="/cancellation-instructions">cancellation instructions</a>.</p>
    </div>
  </section>

  <section class="section alt" aria-labelledby="fit-h">
    <div class="wrap stack">
      <div class="head center"><span class="eyebrow">Is it a fit?</span><h2 class="h2" id="fit-h">Small on purpose, so we're picky.</h2></div>
      <div class="fit">
        <div class="card">
          <h3 class="t3">A good fit if you</h3>
          <ul class="checks">
            <li><span>Have worked through the free Trading Fundamentals course</span></li>
            <li><span>Are practicing in a simulator and want honest feedback</span></li>
            <li><span>Can commit a consistent trading window most weeks</span></li>
            <li><span>Want to build a written plan and follow it</span></li>
          </ul>
        </div>
        <div class="card">
          <h3 class="t3">Not a fit if you want</h3>
          <ul class="checks no">
            <li><span>Someone to tell you what to buy or sell</span></li>
            <li><span>Funding, a managed account or a shortcut to income</span></li>
            <li><span>To skip the simulator and start with real money</span></li>
            <li><span>A guaranteed result. Trading involves substantial risk of loss.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap split">
      <div class="stack" style="gap: 28px">
        <div class="head"><span class="eyebrow">How to join</span><h2 class="h2" id="how-h">Three steps, no pressure.</h2></div>
        <ol class="num-steps">
          <li class="card"><div><h3>Join the free community</h3><p class="muted">Take the 5-question quiz and start the course at the lesson that fits you.</p></div></li>
          <li class="card"><div><h3>Book a short interview</h3><p class="muted">We talk about your goals, your schedule and how you practice, and answer your questions about the two plans.</p></div></li>
          <li class="card"><div><h3>Decide with no pressure</h3><p class="muted">If it's a fit on both sides, you'll get enrollment details. If not, the free community is still yours.</p></div></li>
        </ol>
        <div class="page-hero-actions">
          <a href={APPLY} class="btn" data-cta="mentorship-apply">Book your interview</a>
          <a href="/#quiz" data-cta="mentorship-free">Not a member yet? Start free <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="photo"><img src="/assets/ai/10-first-trading-plan/10-first-trading-plan.jpg" alt="An open notebook with an empty checklist beside a tablet showing a rising chart" loading="lazy" width="1456" height="728"></div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="mfaq-h">
    <div class="wrap faq-list" style="max-width: 820px">
      <div class="head center" style="margin-bottom: 32px"><span class="eyebrow">FAQ</span><h2 class="h2" id="mfaq-h">Mentorship questions.</h2></div>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      <p class="muted" style="margin-top: 28px">Before enrolling, read the <a href="/membership-billing-terms">membership billing terms</a>, <a href="/refund-policy">refund policy</a> and <a href="/cancellation-instructions">cancellation instructions</a>.</p>
    </div>
  </section>
</BaseLayout>
