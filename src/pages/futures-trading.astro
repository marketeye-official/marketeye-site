  .note.tip { background: rgba(34, 217, 138, .06); border-color: rgba(34, 217, 138, .28); }
  .note.tip b { color: var(--green); }
  .example { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin: 18px 0; }
  .example .lbl { font: 500 .7rem var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--cyan); display: block; margin-bottom: 8px; }
  .example p:last-child { margin-bottom: 0; }
  
  /* Tables */
  .tw { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; margin: 18px 0; }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; min-width: 560px; }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { font: 500 .7rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: var(--navy-2); }
  tbody th { color: var(--white); font-weight: 600; }
  tr:last-child td, tr:last-child th { border-bottom: 0; }
  td.num { font-family: var(--f-mono); font-size: .9rem; font-variant-numeric: tabular-nums; color: var(--white); }
  caption { caption-side: bottom; text-align: left; padding: 10px 16px; color: var(--muted); font-size: .84rem; }
  
  /* Tools */
  .tool { background: linear-gradient(180deg, var(--card-2), var(--card)); border: 1px solid var(--line-2); border-radius: 16px; padding: 22px; margin: 22px 0; }
  .tool-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .tool-head h3 { margin: 0; font-size: 1.1rem; }
  .tool-head span { font: 500 .7rem var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--green); }
  .fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 620px) { .fields { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 5px; min-width: 0; }
  .field label { font-size: .8rem; font-weight: 600; color: var(--muted); }
  .field input, .field select { width: 100%; padding: 11px 12px; border-radius: 8px; border: 1px solid var(--line-2); background: rgba(4, 9, 28, .7); color: var(--white); font: 500 1rem var(--f-body); }
  .field input:focus, .field select:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(0, 200, 255, .18); }
  .seg { display: inline-flex; border: 1px solid var(--line-2); border-radius: 8px; overflow: hidden; }
  .seg button { background: transparent; color: var(--muted); border: 0; padding: 10px 12px; font: 600 .9rem var(--f-body); cursor: pointer; flex: 1; }
  .seg button[aria-pressed="true"] { background: rgba(0, 200, 255, .16); color: var(--white); }
  .result { margin-top: 16px; padding: 16px 18px; border-radius: 10px; background: rgba(4, 9, 28, .6); border: 1px solid var(--line); display: grid; gap: 4px; }
  .result .big { font: 800 1.9rem var(--f-display); color: var(--white); font-variant-numeric: tabular-nums; }
  .result .sub { font-size: .92rem; color: var(--muted); }
  .result.warn .big { color: var(--amber); }
  .tool-foot { font-size: .82rem; color: var(--muted); margin-top: 10px; }
  
  /* Session clock */
  .clock { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center; }
  .light { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; }
  .light i { width: 18px; height: 18px; border-radius: 50%; display: block; }
  .light.open { background: rgba(34, 217, 138, .14); } .light.open i { background: var(--green); box-shadow: 0 0 14px var(--green); }
  .light.break { background: rgba(255, 181, 71, .14); } .light.break i { background: var(--amber); }
  .light.closed { background: rgba(255, 90, 90, .12); } .light.closed i { background: var(--red); }
  .clock .state { font: 800 1.35rem var(--f-display); color: var(--white); }
  .clock .detail { color: var(--muted); font-size: .94rem; }
  .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-top: 18px; font: 500 .68rem var(--f-mono); text-align: center; color: var(--muted); }
  .week div { display: grid; gap: 4px; }
  .week span.bar { height: 26px; border-radius: 4px; background: rgba(34, 217, 138, .35); position: relative; overflow: hidden; }
  .week span.bar.closed { background: rgba(255, 90, 90, .18); }
  .week span.bar.partial-start { background: linear-gradient(90deg, rgba(255, 90, 90, .18) 75%, rgba(34, 217, 138, .35) 75%); }
  .week span.bar.partial-end { background: linear-gradient(90deg, rgba(34, 217, 138, .35) 70.8%, rgba(255, 90, 90, .18) 70.8%); }
  .week .today { color: var(--white); }
  
  /* Checklist + steps */
  .steps { counter-reset: st; list-style: none; padding: 0 !important; display: grid; gap: 14px; }
  .steps li { counter-increment: st; display: grid; grid-template-columns: 34px 1fr; gap: 14px; margin: 0; }
  .steps li::before { content: counter(st); width: 34px; height: 34px; border-radius: 50%; background: var(--card); border: 1px solid var(--line-2); color: var(--cyan); display: grid; place-items: center; font: 500 .85rem var(--f-mono); }
  .plan { list-style: none; padding: 0 !important; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .plan li { display: grid; grid-template-columns: 170px 1fr; gap: 16px; padding: 14px 18px; margin: 0; border-bottom: 1px solid var(--line); background: var(--navy-2); }
  .plan li:last-child { border-bottom: 0; }
  .plan li b { font: 500 .78rem var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--cyan); padding-top: 3px; }
  .plan li span { color: var(--muted); }
  @media (max-width: 560px) { .plan li { grid-template-columns: 1fr; gap: 2px; } }
  .mistakes { display: grid; gap: 12px; list-style: none; padding: 0 !important; }
  .mistakes li { padding: 14px 18px; border-left: 3px solid var(--red); background: var(--navy-2); border-radius: 0 10px 10px 0; margin: 0; }
  .mistakes li strong { display: block; margin-bottom: 2px; }
  
  /* FAQ */
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; padding: 18px 40px 18px 0; position: relative; font: 700 1.05rem var(--f-display); color: var(--white); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 4px; top: 14px; font: 500 1.5rem var(--f-mono); color: var(--cyan); transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { color: var(--muted); }
  
  /* End CTA + related */
  .end-cta { margin-top: 12px; padding: clamp(28px, 4vw, 40px); border-radius: 20px; border: 1px solid var(--line-2); background: radial-gradient(ellipse at 50% 0%, rgba(43, 114, 232, .35), transparent 60%), var(--card); display: grid; gap: 14px; justify-items: start; }
  .end-cta h2 { margin: 0; }
  .end-cta p { margin: 0; color: var(--text); }
  .end-cta .micro { font-size: .86rem; color: var(--muted); }
  .related { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
  .related a { display: grid; gap: 2px; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--navy-2); text-decoration: none; color: var(--white); font-weight: 600; line-height: 1.35; }
  .related a span { font: 500 .68rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .related a:hover { border-color: var(--cyan); }
  @media (max-width: 560px) { .related { grid-template-columns: 1fr; } }
  
  /* Footer */
  footer.site { background: var(--navy-2); border-top: 1px solid var(--line); padding-block: 40px; padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px)); font-size: .82rem; color: var(--muted); line-height: 1.6; }
  footer.site .risk { display: grid; gap: 10px; max-width: 900px; }
  footer.site a { color: var(--text); }
  
}
</style>

<script is:inline>
(function () {
  var SPEC = {
    ES:  { name: 'ES',  pointValue: 50, tick: 0.25, tickValue: 12.5 },
    MES: { name: 'MES', pointValue: 5,  tick: 0.25, tickValue: 1.25 },
    NQ:  { name: 'NQ',  pointValue: 20, tick: 0.25, tickValue: 5 },
    MNQ: { name: 'MNQ', pointValue: 2,  tick: 0.25, tickValue: 0.5 }
  };
  function money(n) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function num(el) { var v = parseFloat(el.value); return isFinite(v) && v >= 0 ? v : 0; }
  function plural(n, w) { return n + ' ' + w + (n === 1 ? '' : 's'); }

  /* Tick value calculator */
  var unit = 'points';
  var tc = { c: document.getElementById('tc-contract'), a: document.getElementById('tc-amount'), q: document.getElementById('tc-qty'),
    out: document.getElementById('tc-out'), sub: document.getElementById('tc-sub'),
    pts: document.getElementById('tc-unit-points'), tks: document.getElementById('tc-unit-ticks') };
  function calcTick() {
    var s = SPEC[tc.c.value], amt = num(tc.a), qty = Math.max(1, Math.floor(num(tc.q)) || 1);
    var ticks = unit === 'points' ? Math.round(amt / s.tick) : Math.round(amt);
    var dollars = ticks * s.tickValue * qty;
    tc.out.textContent = money(dollars);
    var lead = unit === 'points' ? (amt + ' ' + (amt === 1 ? 'point' : 'points') + ' = ' + plural(ticks, 'tick')) : plural(ticks, 'tick') + ' (' + (ticks * s.tick) + ' points)';
    tc.sub.textContent = lead + ' × ' + money(s.tickValue) + ' × ' + plural(qty, 'contract');
  }
  function setUnit(u) {
    if (u === unit) return;
    var s = SPEC[tc.c.value], amt = num(tc.a);
    tc.a.value = u === 'ticks' ? Math.round(amt / s.tick) : (amt * s.tick);
    tc.a.step = u === 'ticks' ? '1' : '0.25';
    unit = u;
    tc.pts.setAttribute('aria-pressed', String(u === 'points'));
    tc.tks.setAttribute('aria-pressed', String(u === 'ticks'));
    calcTick();
  }
  [tc.c, tc.a, tc.q].forEach(function (el) { el.addEventListener('input', calcTick); });
  tc.pts.addEventListener('click', function () { setUnit('points'); });
  tc.tks.addEventListener('click', function () { setUnit('ticks'); });
  calcTick();

  /* Position size calculator */
  var ps = { r: document.getElementById('ps-risk'), s: document.getElementById('ps-stop'), c: document.getElementById('ps-contract'),
    box: document.getElementById('ps-result'), out: document.getElementById('ps-out'), sub: document.getElementById('ps-sub') };
  function calcSize() {
    var spec = SPEC[ps.c.value], risk = num(ps.r), stop = Math.round(num(ps.s));
    if (!risk || !stop) {
      ps.box.classList.add('warn'); ps.out.textContent = '—';
      ps.sub.textContent = 'Enter a max risk above $0 and a stop of at least 1 tick.'; return;
    }
    var perContract = stop * spec.tickValue;
    var n = Math.floor(risk / perContract);
    if (n < 1) {
      ps.box.classList.add('warn');
      ps.out.textContent = '0 contracts';
      ps.sub.textContent = 'One ' + spec.name + ' contract would risk ' + money(perContract) + ', which is more than your ' + money(risk) + ' limit. A micro contract or a closer stop in your plan would fit.';
      return;
    }
    ps.box.classList.remove('warn');
    ps.out.textContent = plural(n, 'contract');
    ps.sub.textContent = 'Each contract risks ' + plural(stop, 'tick') + ' × ' + money(spec.tickValue) + ' = ' + money(perContract) + '. Total risk: ' + money(n * perContract) + '.';
  }
  [ps.r, ps.s, ps.c].forEach(function (el) { el.addEventListener('input', calcSize); });
  calcSize();

  /* Session clock (CME equity index futures, regular weekly schedule, US Eastern) */
  var DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  function nowET() {
    var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    var o = {}; parts.forEach(function (p) { o[p.type] = p.value; });
    var h = parseInt(o.hour, 10) % 24, m = parseInt(o.minute, 10);
    return { day: DAYS.indexOf(o.weekday), mins: h * 60 + m, label: o.weekday + ' ' + new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }).format(new Date()) + ' ET' };
  }
  function status(t) {
    var d = t.day, m = t.mins, OPEN = 18 * 60, CLOSE = 17 * 60;
    if (d === 6) return ['closed', 'Closed for the weekend', 'Futures reopen Sunday at 6:00 PM ET.'];
    if (d === 0) return m >= OPEN ? ['open', 'Open', 'The new trading week started at 6:00 PM ET.'] : ['closed', 'Closed for the weekend', 'Futures reopen today at 6:00 PM ET.'];
    if (d === 5 && m >= CLOSE) return ['closed', 'Closed for the weekend', 'Futures reopen Sunday at 6:00 PM ET.'];
    if (d >= 1 && d <= 4 && m >= CLOSE && m < OPEN) return ['break', 'Daily break', 'Trading resumes at 6:00 PM ET.'];
    var cash = m >= 9 * 60 + 30 && m < 16 * 60;
    return ['open', cash ? 'Open · US cash session' : 'Open', cash ? 'The stock market is also open, so volume is usually highest now.' : (d === 5 ? 'The market closes for the weekend at 5:00 PM ET.' : 'Next daily break at 5:00 PM ET.')];
  }
  var light = document.getElementById('clk-light'), st = document.getElementById('clk-state'), det = document.getElementById('clk-detail'), wk = document.getElementById('clk-week');
  function renderClock() {
    var t = nowET(), s = status(t);
    light.className = 'light ' + s[0];
    st.textContent = s[1];
    det.textContent = 'It\'s ' + t.label + '. ' + s[2];
    var cls = ['partial-start', '', '', '', '', 'partial-end', 'closed'];
    wk.innerHTML = DAYS.map(function (d, i) { return '<div class="' + (i === t.day ? 'today' : '') + '"><span class="bar ' + cls[i] + '"></span>' + d + '</div>'; }).join('');
  }
  renderClock();
  setInterval(renderClock, 30000);

  /* Contents highlight */
  var links = Array.prototype.slice.call(document.querySelectorAll('#toc a'));
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) links.forEach(function (a) { a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id); });
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    document.querySelectorAll('article section[id]').forEach(function (s) { io.observe(s); });
  }

  /* Analytics hook */
  document.querySelectorAll('[data-cta]').forEach(function (a) {
    a.addEventListener('click', function () { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'cta_click', location: 'futures101_' + a.getAttribute('data-cta') }); });
  });
})();
</script>
