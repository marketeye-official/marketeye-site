<style is:global>
/* Futures 101 page styles, nested under .f101 so they never leak into other pages. */
.f101 {
  h1, h2, h3 { font-family: var(--f-display); color: var(--white); line-height: 1.15; margin: 0; text-wrap: balance; }
  .mono { font-family: var(--f-mono); }
  .btn { min-height: 0; padding: 13px 22px; font-size: 1rem; }
  .btn-sm { padding: 9px 16px; font-size: .9rem; }
  .wrap { max-width: 1180px; }
  font-size: 18px; line-height: 1.7;
  /* Guide header */
  .guide-head { padding-block: 44px 40px; border-bottom: 1px solid var(--line); background: radial-gradient(ellipse 60% 120% at 85% 0%, rgba(43, 114, 232, .22), transparent 60%); }
  .crumbs { font: 500 .75rem var(--f-mono); letter-spacing: .08em; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--cyan); }
  .guide-head h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 800; margin: 16px 0 14px; max-width: 18ch; }
  .guide-head .lede { font-size: 1.2rem; max-width: 62ch; color: var(--text); }
  .meta-row { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; font: 500 .78rem var(--f-mono); color: var(--muted); }
  .meta-row b { color: var(--green); font-weight: 500; }
  .key-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; margin-top: 30px; }
  .key-facts div { background: var(--navy-2); padding: 16px 18px; display: grid; gap: 2px; }
  .key-facts b { font: 800 1.35rem var(--f-display); color: var(--white); font-variant-numeric: tabular-nums; }
  .key-facts span { font-size: .88rem; color: var(--muted); line-height: 1.4; }
  @media (max-width: 760px) { .key-facts { grid-template-columns: 1fr 1fr; } }
  
  /* Article layout */
  .layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 56px; padding-block: 48px 80px; }
  .rail { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; display: grid; gap: 22px; }
  .toc { display: grid; gap: 2px; font-size: .9rem; }
  .toc b { font: 500 .7rem var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .toc a { color: var(--muted); text-decoration: none; padding: 4px 0 4px 12px; border-left: 2px solid var(--line); line-height: 1.35; }
  .toc a:hover, .toc a.on { color: var(--white); border-left-color: var(--cyan); }
  .rail-cta { padding: 18px; border-radius: 14px; background: var(--card); border: 1px solid var(--line-2); display: grid; gap: 10px; }
  .rail-cta strong { font: 700 1.05rem var(--f-display); color: var(--white); line-height: 1.25; }
  .rail-cta p { font-size: .9rem; color: var(--muted); margin: 0; line-height: 1.5; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; gap: 0; } .rail { display: none; } }
  
  article { min-width: 0; max-width: 760px; }
  article section { padding-block: 8px 40px; }
  article section + section { border-top: 1px solid var(--line); padding-top: 40px; }
  article h2 { font-size: clamp(1.6rem, 3vw, 2.05rem); font-weight: 800; margin-bottom: 16px; }
  article h3 { font-size: 1.2rem; margin: 26px 0 10px; }
  article p { margin: 0 0 16px; max-width: 68ch; }
  article ul, article ol { margin: 0 0 16px; padding-left: 1.3em; max-width: 68ch; }
  article li { margin-bottom: 8px; }
  article strong { color: var(--white); }
  .sec-num { display: block; font: 500 .74rem var(--f-mono); letter-spacing: .14em; color: var(--cyan); margin-bottom: 8px; }
  .note { padding: 16px 18px; border-radius: 10px; margin: 18px 0; font-size: .97rem; border: 1px solid; }
