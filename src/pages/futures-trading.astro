// Futures Trading 101: the main SEO pillar page, with a tick value calculator,
// a position size calculator and a live futures market-hours clock.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ico } from '../lib/icons';
import '../styles/guide.css';
import TickCalculator from '../components/tools/TickCalculator.astro';
import SizeCalculator from '../components/tools/SizeCalculator.astro';
import MarketClock from '../components/tools/MarketClock.astro';

// "Keep learning": real posts from the blog.
const RELATED = ['what-is-risk-management-and-why-does-it-matter', 'building-a-repeatable-trading-process', '7-costly-trading-mistakes-new-traders-make'];
const related = (await getCollection('posts')).filter((p) => RELATED.includes(p.id)).sort((a, b) => RELATED.indexOf(a.id) - RELATED.indexOf(b.id));
const schema = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Futures Trading for Beginners: Futures Trading 101",
        "description": "What a futures contract is, ES vs MES and NQ vs MNQ, tick values, trading hours, rollover, margin, and risk, with free calculators.",
        "datePublished": "2026-10-11",
        "dateModified": "2026-10-11",
        "author": {
          "@type": "Organization",
          "name": "MarketEye"
        },
        "publisher": {
          "@type": "Organization",
          "name": "MarketEye",
          "url": "https://marketeye.io/"
        },
        "mainEntityOfPage": "https://marketeye.io/futures-trading"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://marketeye.io/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Futures Trading 101",
            "item": "https://marketeye.io/futures-trading"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is futures trading good for beginners?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It can be, if you learn on micro contracts in a simulator first and put risk management before strategy. Futures are leveraged, so beginners who skip that step often lose money quickly."
            }
          },
          {
            "@type": "Question",
            "name": "How much money do I need to start trading futures?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You need no money to start learning, because simulators are free or low-cost. To trade real money, your broker sets the minimum deposit and margin requirements, and they vary. Whatever the amount, it should be money you can afford to lose, because futures losses can exceed your deposit."
            }
          },
          {
            "@type": "Question",
            "name": "What is the difference between ES and MES?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "MES is the micro version of ES and is one-tenth the size. ES is worth $50 per point ($12.50 per tick), and MES is worth $5 per point ($1.25 per tick). They follow the same index, so the charts look the same."
            }
          },
          {
            "@type": "Question",
            "name": "What hours can you trade futures?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "US equity index futures trade on CME Globex from Sunday 6:00 PM ET to Friday 5:00 PM ET, with a daily break from 5:00 to 6:00 PM ET Monday through Thursday. Holiday schedules differ."
            }
          },
          {
            "@type": "Question",
            "name": "Does the pattern day trader rule apply to futures?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. The pattern day trader rule applies to stock margin accounts. Futures accounts follow your broker's margin requirements instead."
            }
          },
          {
            "@type": "Question",
            "name": "Can you lose more than you invest in futures?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Because futures are leveraged, a fast move against your position can produce losses larger than the money in your account, and you'd owe the difference to your broker."
            }
          }
        ]
      }
    ]
  }
];
---
<BaseLayout
  title="Futures Trading for Beginners: Futures Trading 101 | MarketEye"
  description="Learn futures trading from scratch: what a futures contract is, ES vs MES and NQ vs MNQ, tick values, trading hours, rollover, margin, and risk. Free calculators included."
  ogType="article"
  ogTitle="Futures Trading for Beginners: Futures Trading 101"
  ogDescription="What a futures contract is, ES vs MES, tick values, trading hours, margin, and risk, with free calculators."
  path="/futures-trading"
  schema={schema}
  stickyCta={false}
>
<div class="guide">
<section class="guide-head">
  <div class="wrap split">
    <div class="guide-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Futures Trading 101</span></nav>
      <h1>Futures Trading for Beginners: Futures Trading 101</h1>
      <p class="lede">Everything a new trader needs to understand before placing a first futures trade: what a contract is, how ticks turn into dollars, when the market is open, and how to manage risk on a leveraged product. Written for complete beginners, with free calculators.</p>
      <div class="guide-actions">
        <a href="#ticks" class="btn">Try the calculators</a>
        <a href="/#quiz" class="btn ghost" data-cta="futures101-hero">Get my free plan</a>
      </div>
      <div class="meta-row"><span>By the MarketEye trading team</span><span>Updated Oct 14, 2026</span><span>~15 min read</span><span><b>●</b> Education only, not trade recommendations</span></div>
    </div>
    <div class="photo"><img src="/assets/ai/06-reading-charts/06-reading-charts.jpg" alt="Glowing cyan and purple candlesticks rising across a dark background" width="1456" height="728"><span class="tag" style="left: 24px; bottom: 24px"><Fragment set:html={ico('layers')} />ES · MES · NQ · MNQ</span></div>
  </div>
</section>

<section class="facts-band" aria-label="Key facts">
  <div class="wrap key-facts">
    <div class="card fact"><span class="ico"><Fragment set:html={ico('dollar')} /></span><b>$12.50</b><span>Value of one tick on the E-mini S&amp;P 500 (ES)</span></div>
    <div class="card fact"><span class="ico"><Fragment set:html={ico('micro')} /></span><b>$1.25</b><span>Value of one tick on the Micro E-mini (MES)</span></div>
    <div class="card fact"><span class="ico"><Fragment set:html={ico('clock')} /></span><b>~23 hrs</b><span>Index futures trade Sunday evening to Friday afternoon</span></div>
    <div class="card fact"><span class="ico"><Fragment set:html={ico('calendar')} /></span><b>4×</b><span>Quarterly contract months: Mar, Jun, Sep, Dec</span></div>
  </div>
</section>

<div class="wrap layout">
  <aside class="rail" aria-label="On this page">
    <nav class="toc" id="toc">
      <b>On this page</b>
      <a href="#what">What is a futures contract?</a>
      <a href="#why">Why traders learn futures</a>
      <a href="#contracts">E-mini vs micro contracts</a>
      <a href="#ticks">Tick size and tick value</a>
      <a href="#hours">Futures trading hours</a>
      <a href="#rollover">Contract months and rollover</a>
      <a href="#margin">Leverage and margin</a>
      <a href="#vs-stocks">Futures vs stocks</a>
      <a href="#risk">Position sizing</a>
      <a href="#practice">Practice in a simulator</a>
      <a href="#plan">Your first trading plan</a>
      <a href="#mistakes">Beginner mistakes</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="rail-cta">
      <strong>Learn futures with a community beside you</strong>
      <p>Answer 5 questions and get a free starting plan plus an invite to the MarketEye community.</p>
      <a href="/#quiz" class="btn btn-sm" data-cta="futures101-rail">Get my free plan</a>
    </div>
  </aside>

  <article>
    <section id="what">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('book')} /></span><div><span class="sec-num">01 · THE BASICS</span><h2>What is a futures contract?</h2></div></div>
      <p>A <strong>futures contract</strong> is a standardized agreement to buy or sell something at a set price on a set date in the future. The "something" can be a stock index, crude oil, gold, interest rates, or currencies. Every contract on the exchange has the same size, tick size, and expiration rules, which is why they're easy to compare and trade.</p>
      <p>Most futures day traders never take or deliver anything. They open a position and close it the same day, and their profit or loss is the difference between the two prices. Index futures like the E-mini S&amp;P 500 are also <strong>cash-settled</strong>, so there's no physical delivery even if you held one to expiration.</p>
      <div class="example">
        <span class="lbl">Simulated example</span>
        <p>A trader buys 1 Micro E-mini S&amp;P 500 (MES) contract at 5,840.00 in a simulator and sells it at 5,844.00. That's a 4-point move. Each MES point is worth $5, so the simulated result is a $20 gain before fees. If price had fallen 4 points instead, it would have been a $20 loss.</p>
      </div>
      <p>Futures trade on regulated exchanges. In the US, the most popular index futures trade on the CME Group's electronic platform, CME Globex, and the market is overseen by the Commodity Futures Trading Commission (CFTC).</p>
    </section>

    <section id="why">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('bulb')} /></span><div><span class="sec-num">02 · WHY FUTURES</span><h2>Why traders learn futures</h2></div></div>
      <div class="why-grid">
        <div class="card why"><span class="ico"><Fragment set:html={ico('clock')} /></span><h3>Nearly around-the-clock hours</h3><p>Index futures trade from Sunday evening to Friday afternoon (US Eastern), so you can practice before work or in the evening.</p></div>
        <div class="card why"><span class="ico"><Fragment set:html={ico('hub')} /></span><h3>One centralized market</h3><p>Every order for a contract goes to the same exchange, so everyone sees the same prices and volume.</p></div>
        <div class="card why"><span class="ico"><Fragment set:html={ico('micro')} /></span><h3>Small, standardized contracts</h3><p>Micro contracts are one-tenth the size of the E-minis, which makes the numbers easier for beginners to follow.</p></div>
        <div class="card why"><span class="ico"><Fragment set:html={ico('target')} /></span><h3>A few markets to master</h3><p>Many traders focus on just one or two contracts, such as ES and NQ, instead of scanning thousands of stocks.</p></div>
      </div>
      <div class="note risk"><b>Leverage cuts both ways.</b> A small deposit controls a much larger contract value. That's what makes futures efficient, and it's also why losses can exceed the money in your account. Risk management comes before everything else on this page.</div>
    </section>

    <section id="contracts">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('layers')} /></span><div><span class="sec-num">03 · CONTRACTS</span><h2>E-mini vs micro futures: ES, MES, NQ, MNQ</h2></div></div>
      <p>The two most popular index futures are the <strong>E-mini S&amp;P 500 (ES)</strong>, which tracks the 500 large US companies in the S&amp;P 500, and the <strong>E-mini Nasdaq-100 (NQ)</strong>, which tracks 100 of the largest Nasdaq-listed companies. Each has a <strong>micro</strong> version that is exactly one-tenth the size.</p>
      <div class="tw">
        <table>
          <caption>Contract specifications per CME Group. Confirm current specs with the exchange and your broker.</caption>
          <thead><tr><th scope="col">Contract</th><th scope="col">Symbol</th><th scope="col">Value per point</th><th scope="col">Tick size</th><th scope="col">Value per tick</th></tr></thead>
          <tbody>
            <tr><th scope="row">E-mini S&amp;P 500</th><td class="num">ES</td><td class="num">$50.00</td><td class="num">0.25</td><td class="num">$12.50</td></tr>
            <tr><th scope="row">Micro E-mini S&amp;P 500</th><td class="num">MES</td><td class="num">$5.00</td><td class="num">0.25</td><td class="num">$1.25</td></tr>
            <tr><th scope="row">E-mini Nasdaq-100</th><td class="num">NQ</td><td class="num">$20.00</td><td class="num">0.25</td><td class="num">$5.00</td></tr>
            <tr><th scope="row">Micro E-mini Nasdaq-100</th><td class="num">MNQ</td><td class="num">$2.00</td><td class="num">0.25</td><td class="num">$0.50</td></tr>
          </tbody>
        </table>
      </div>
      <figure class="fig"><img src="/assets/ai/08-charting-platform/08-charting-platform.jpg" alt="A charting platform on a laptop screen showing candlesticks, volume and an indicator panel" width="1456" height="728" loading="lazy"></figure>
      <h3>Which should a beginner learn first?</h3>
      <p>Most beginners learn on <strong>micro contracts in a simulator</strong>. The price chart is identical to the E-mini, so every lesson carries over, but each move is worth one-tenth as much. NQ and MNQ usually move more points per day than ES and MES, so many new traders find the S&amp;P contracts calmer to learn on.</p>
    </section>

    <section id="ticks">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('ruler')} /></span><div><span class="sec-num">04 · TICKS</span><h2>Tick size and tick value, explained</h2></div></div>
      <p>A <strong>tick</strong> is the smallest price move a contract can make. For ES, MES, NQ, and MNQ, one tick is 0.25 points, so there are 4 ticks in every point. The <strong>tick value</strong> is how much money one tick is worth per contract.</p>
      <p>The formula is simple: <span class="mono">dollar change = ticks moved × tick value × contracts</span>. Try it below.</p>

      <TickCalculator />
    </section>

    <section id="hours">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('clock')} /></span><div><span class="sec-num">05 · HOURS</span><h2>Futures trading hours</h2></div></div>
      <p>US equity index futures (ES, MES, NQ, MNQ) trade on CME Globex almost 23 hours a day, five days a week. All times below are US Eastern Time (ET).</p>
      <div class="tw">
        <table>
          <thead><tr><th scope="col">Period</th><th scope="col">Time (ET)</th><th scope="col">What it means</th></tr></thead>
          <tbody>
            <tr><th scope="row">Weekly open</th><td class="num">Sun 6:00 PM</td><td>Trading starts for the week.</td></tr>
            <tr><th scope="row">Daily break</th><td class="num">Mon–Thu 5:00–6:00 PM</td><td>A one-hour pause each evening.</td></tr>
            <tr><th scope="row">US cash session</th><td class="num">Mon–Fri 9:30 AM–4:00 PM</td><td>When the stock market is open. Volume and movement are usually highest here, especially in the first hour.</td></tr>
            <tr><th scope="row">Weekly close</th><td class="num">Fri 5:00 PM</td><td>Trading stops for the weekend.</td></tr>
          </tbody>
        </table>
      </div>

      <MarketClock />
      <div class="note tip"><b>Schedule tip:</b> you don't need to trade all day. Many MarketEye members pick one consistent 60 to 90 minute window, such as the first hour of the cash session or an evening window, and practice only then.</div>
    </section>

    <section id="rollover">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('refresh')} /></span><div><span class="sec-num">06 · EXPIRATION</span><h2>Contract months, symbols, and rollover</h2></div></div>
      <p>Index futures expire four times a year. Each contract month has a one-letter code, and the full symbol adds the year. For example, <span class="mono">ESZ26</span> is the E-mini S&amp;P 500 expiring in December 2026.</p>
      <div class="tw">
        <table>
          <thead><tr><th scope="col">Month</th><th scope="col">March</th><th scope="col">June</th><th scope="col">September</th><th scope="col">December</th></tr></thead>
          <tbody><tr><th scope="row">Code</th><td class="num">H</td><td class="num">M</td><td class="num">U</td><td class="num">Z</td></tr></tbody>
        </table>
      </div>
      <p>Equity index futures expire on the <strong>third Friday</strong> of the contract month. About a week before that, most traders <strong>roll over</strong> to the next contract because that's where the volume moves. Your platform will usually show which contract is the "front month." Always check that your chart and your order ticket are on the same contract.</p>
    </section>

    <section id="margin">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('scale')} /></span><div><span class="sec-num">07 · LEVERAGE</span><h2>Leverage and margin, explained</h2></div></div>
      <p><strong>Margin</strong> in futures is a good-faith deposit, not a loan. The exchange sets an <strong>initial margin</strong> to open a position overnight and a <strong>maintenance margin</strong> you must keep above. Many brokers also set lower <strong>day-trading margins</strong> for positions closed before the end of the session. All of these amounts change, so check your broker's current requirements.</p>
      <p>Because the deposit is small compared with the full contract value, futures are <strong>leveraged</strong>. One ES contract controls 50 times the index level. At an index level of 5,800, that's $290,000 of exposure, regardless of how much money is in the account.</p>
      <div class="note risk"><b>You can lose more than you deposit.</b> If a position moves against you quickly, your losses aren't capped at your account balance. Your broker can also close positions if your account falls below margin. This is the main reason to learn on a simulator and to size positions from your risk, not from your available margin.</div>
    </section>

    <section id="vs-stocks">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('compare')} /></span><div><span class="sec-num">08 · COMPARISON</span><h2>Futures vs stocks for a new trader</h2></div></div>
      <div class="tw">
        <table>
          <thead><tr><th scope="col"></th><th scope="col">Index futures</th><th scope="col">Individual stocks</th></tr></thead>
          <tbody>
            <tr><th scope="row">Trading hours</th><td>Nearly 23 hours, Sun–Fri</td><td>Mainly 9:30 AM–4:00 PM ET, plus limited extended hours</td></tr>
            <tr><th scope="row">What you study</th><td>One or two contracts</td><td>Thousands of tickers to scan</td></tr>
            <tr><th scope="row">Pattern day trader rule</th><td>Doesn't apply (broker margin rules do)</td><td>Applies to margin accounts under $25,000</td></tr>
            <tr><th scope="row">Leverage</th><td>Built in; losses can exceed deposit</td><td>Optional margin; cash accounts can't lose more than invested</td></tr>
            <tr><th scope="row">Expiration</th><td>Quarterly; roll to the next contract</td><td>None</td></tr>
            <tr><th scope="row">Short selling</th><td>As simple as buying</td><td>Requires borrowing shares</td></tr>
          </tbody>
        </table>
      </div>
      <p>Neither is "better." Futures suit people who want a small number of markets and flexible hours. The trade-off is built-in leverage, which makes risk management non-negotiable.</p>
    </section>

    <section id="risk">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('shield')} /></span><div><span class="sec-num">09 · RISK</span><h2>How to size a futures position</h2></div></div>
      <p>Professional traders size positions backwards: they start with how much they're willing to lose on one trade, then work out how many contracts that allows. Many traders cap a single trade's risk at a small, fixed share of their account, and also set a <strong>daily loss limit</strong> that ends the session when it's hit.</p>
      <figure class="fig"><img src="/assets/ai/07-risk-management/07-risk-management.jpg" alt="A glowing shield standing over a price chart" width="1456" height="728" loading="lazy"></figure>
      <p><span class="mono">max contracts = risk per trade ÷ (stop distance in ticks × tick value)</span></p>

      <SizeCalculator />
    </section>

    <section id="practice">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('monitor')} /></span><div><span class="sec-num">10 · PRACTICE</span><h2>Practice in a simulator before risking money</h2></div></div>
      <p>A futures simulator uses live market data but fake money. It's where you learn the platform, test your rules, and build a track record without the cost of beginner mistakes.</p>
      <figure class="fig"><img src="/assets/ai/04-practice-first/04-practice-first.jpg" alt="Hands on a keyboard in front of two monitors with glowing candlestick charts" width="1456" height="728" loading="lazy"></figure>
      <ol class="steps">
        <li><span><strong>Pick one contract.</strong> MES is the most common starting point. Learn how it moves before adding a second market.</span></li>
        <li><span><strong>Pick one setup.</strong> Learn one complete pattern, with entry, stop, and exit rules, from start to finish.</span></li>
        <li><span><strong>Trade the same window every day.</strong> Consistency in timing makes your results comparable.</span></li>
        <li><span><strong>Journal every trade.</strong> Record the setup, whether you followed your rules, and how you felt.</span></li>
        <li><span><strong>Review weekly against benchmarks.</strong> Look at rule-following first and results second. Only consider real money after a long stretch of consistent simulated results.</span></li>
      </ol>
      <div class="note tip"><b>Inside MarketEye:</b> the team posts step-by-step trade breakdowns, and members share their own simulated charts in the comments for feedback. MES is the contract we trade most often as a group.</div>
    </section>

    <section id="plan">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('clipboard')} /></span><div><span class="sec-num">11 · YOUR PLAN</span><h2>Your first futures trading plan</h2></div></div>
      <p>A trading plan is a short set of written rules you follow every session. If a rule isn't written down, it's easy to break under pressure. Start with these sections:</p>
      <figure class="fig"><img src="/assets/ai/10-first-trading-plan/10-first-trading-plan.jpg" alt="An open notebook with an empty checklist beside a tablet showing a rising chart" width="1456" height="728" loading="lazy"></figure>
      <ul class="plan">
        <li><b>Market</b><span>Which contract you trade (for example, MES only).</span></li>
        <li><b>Session</b><span>Your trading window, such as 9:30 to 11:00 AM ET.</span></li>
        <li><b>Setup</b><span>The one pattern you're allowed to trade, described in plain words.</span></li>
        <li><b>Entry</b><span>The exact condition that gets you in.</span></li>
        <li><b>Stop</b><span>Where you're wrong, decided before you enter.</span></li>
        <li><b>Target</b><span>Where you take profit, or how you trail.</span></li>
        <li><b>Size</b><span>Your max risk per trade and the contract count that results.</span></li>
        <li><b>Daily limit</b><span>The loss, or number of losing trades, that ends your day.</span></li>
        <li><b>Review</b><span>When you journal and when you review the week.</span></li>
      </ul>
    </section>

    <section id="mistakes">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('alert')} /></span><div><span class="sec-num">12 · AVOID</span><h2>Common futures trading mistakes beginners make</h2></div></div>
      <div class="mistakes">
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Sizing from margin instead of risk</h3><p>Just because you can open 5 contracts doesn't mean your plan allows it.</p></div></div>
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Trading without a stop</h3><p>Leverage turns a "it'll come back" moment into an account-ending one.</p></div></div>
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Revenge trading after a loss</h3><p>Your daily loss limit exists for this exact moment.</p></div></div>
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Jumping between markets</h3><p>ES in the morning, crude oil at lunch, NQ in the afternoon means you never learn one well.</p></div></div>
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Trading the wrong contract month</h3><p>Check the symbol after every rollover.</p></div></div>
        <div class="card mistake"><span class="ico"><Fragment set:html={ico('x')} /></span><div><h3>Skipping the simulator</h3><p>Real money is an expensive place to learn the order ticket.</p></div></div>
      </div>
    </section>

    <section id="faq">
      <div class="sec-head"><span class="ico"><Fragment set:html={ico('chat')} /></span><div><span class="sec-num">13 · FAQ</span><h2>Futures trading FAQ</h2></div></div>
      <details><summary>Is futures trading good for beginners?</summary><p>It can be, if you learn on micro contracts in a simulator first and put risk management before strategy. Futures are leveraged, so beginners who skip that step often lose money quickly.</p></details>
      <details><summary>How much money do I need to start trading futures?</summary><p>You need no money to start learning, because simulators are free or low-cost. To trade real money, your broker sets the minimum deposit and margin requirements, and they vary. Whatever the amount, it should be money you can afford to lose, because futures losses can exceed your deposit.</p></details>
      <details><summary>What is the difference between ES and MES?</summary><p>MES is the micro version of ES and is one-tenth the size. ES is worth $50 per point ($12.50 per tick), and MES is worth $5 per point ($1.25 per tick). They follow the same index, so the charts look the same.</p></details>
      <details><summary>What hours can you trade futures?</summary><p>US equity index futures trade on CME Globex from Sunday 6:00 PM ET to Friday 5:00 PM ET, with a daily break from 5:00 to 6:00 PM ET Monday through Thursday. Holiday schedules differ.</p></details>
      <details><summary>Does the pattern day trader rule apply to futures?</summary><p>No. The pattern day trader rule applies to stock margin accounts. Futures accounts follow your broker's margin requirements instead.</p></details>
      <details><summary>Can you lose more than you invest in futures?</summary><p>Yes. Because futures are leveraged, a fast move against your position can produce losses larger than the money in your account, and you'd owe the difference to your broker.</p></details>
    </section>

  </article>
</div>

