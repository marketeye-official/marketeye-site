<script is:inline>
(function () {
  var SPEC = {
    ES:  { name: 'ES',  pointValue: 50, tick: 0.25, tickValue: 12.5 },
    MES: { name: 'MES', pointValue: 5,  tick: 0.25, tickValue: 1.25 },
