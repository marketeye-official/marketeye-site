---
// Sticky site header with Free Education dropdown and mobile menu. Behavior lives in BaseLayout.
---
<header class="site-header">
  <div class="wrap nav">
    <a href="/#top" class="brand" aria-label="MarketEye home"><img src="/assets/marketeye-logo.png" alt="MarketEye" width="186" height="30"></a>
    <nav aria-label="Main">
      <ul class="nav-links">
        <li class="has-dd">
          <button class="dd-toggle" aria-expanded="false" aria-controls="dd-learn">Free Education
            <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <div class="dropdown" id="dd-learn">
            <a href="/futures-trading"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18l5-6 4 3 7-9"/></svg></span><strong>Futures Trading 101</strong><span class="d">Contracts, ticks, sessions, risk</span></a>
            <a href="/#learn"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/></svg></span><strong>Trading Fundamentals</strong><span class="d">26 free lessons in 8 modules</span></a>
            <a href="/#prep"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span><strong>Weekly Pre-Trade Prep</strong><span class="d">The week's releases and what to watch</span></a>
            <a href="/tools/tick-value-calculator"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 12h2M13 12h2M9 16h2M13 16h2"/></svg></span><strong>Free Futures Tools</strong><span class="d">Tick value and position-size calculators</span></a>
            <a href="/blog"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><strong>Blog</strong><span class="d">Futures trading articles</span></a>
          </div>
        </li>
        <li><a href="/#community">Community</a></li>
        <li><a href="/#method">The Method</a></li>
        <li><a href="/mentorship">Mentorship</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </nav>
    <div class="nav-actions">
      <a href="https://learn.marketeye.io" class="login">Log in</a>
      <a href="/#quiz" class="btn btn-sm" data-cta="nav">Join Free</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <div class="group-label">Free Education</div>
    <a href="/futures-trading">Futures Trading 101</a>
    <a href="/#learn">Trading Fundamentals</a>
    <a href="/#prep">Weekly Pre-Trade Prep</a>
    <a href="/tools/tick-value-calculator">Free Futures Tools</a>
    <a href="/blog">Blog</a>
    <div class="group-label">MarketEye</div>
    <a href="/#community">Community</a>
    <a href="/#method">The Method</a>
    <a href="/mentorship">Mentorship</a>
    <a href="/#faq">FAQ</a>
    <a href="https://learn.marketeye.io">Log in</a>
    <a href="/#quiz" class="btn" data-cta="mobile-menu">Join the Free Community</a>
  </div>
</header>
