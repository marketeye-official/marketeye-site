---
// The 5-question hero quiz: renders a personal starting plan, then reveals the live signup form
// (same consent gate and Make.com scenario as the landing pages) with the quiz answers attached.
import SignupForm from './signup/SignupForm.astro';
import TosModal from './signup/TosModal.astro';
---
<div class="quiz" id="quiz">
  <div class="quiz-top"><span id="quiz-step-label">Question 1 of 5</span><span class="live">~45 sec</span></div>
  <div class="progress" aria-hidden="true"><span id="quiz-progress"></span></div>
  <div id="quiz-body" aria-live="polite"></div>
  <div class="quiz-signup" id="quiz-signup" hidden>
    <SignupForm />
    <div class="quiz-foot"><button type="button" class="back" id="quiz-change">← Change answers</button><span>Free forever · No credit card</span></div>
  </div>
</div>
<TosModal />

<script is:inline>
(function () {
  /* ---------- Quiz ---------- */
  var QUESTIONS = [
    { id: 'training_time', q: 'How much time can you dedicate to training each week?', hint: 'Lessons, replays, and practice.', opts: [
      ['under_2h', 'Under 2 hours'], ['2_5h', '2 to 5 hours'], ['5_10h', '5 to 10 hours'], ['10h_plus', '10+ hours'] ], cols: 2 },
    { id: 'trading_time', q: 'How much time can you dedicate to day trading each week?', hint: 'Time watching and trading the market.', opts: [
      ['not_yet', "I'm not ready to trade yet"], ['under_3h', 'Under 3 hours (about 30 min a day)'], ['3_8h', '3 to 8 hours (about 1 to 1.5 hrs a day)'], ['8h_plus', '8+ hours'] ] },
    { id: 'capital_belief', q: 'How much capital do you believe is needed to start your trading business?', hint: "There's no wrong answer. This helps us set expectations.", opts: [
      ['under_1k', 'Under $1,000'], ['1k_5k', '$1,000 to $5,000'], ['5k_25k', '$5,000 to $25,000'], ['25k_plus', '$25,000+'], ['unsure', "I honestly don't know"] ] },
    { id: 'prior_education', q: 'Have you taken a trading course or joined a community before?', hint: 'Be honest. It helps us skip what you already know.', opts: [
      ['none', 'No, this is my first step'], ['course', 'Yes, a course'], ['community', 'Yes, a community or chat room'], ['both', 'Yes, both'] ] },
    { id: 'biggest_struggle', q: "What's been your biggest struggle so far?", hint: 'Pick the one that costs you the most.', opts: [
      ['consistency', 'Consistency'], ['discipline', 'Discipline'], ['strategy', 'Finding a strategy'], ['risk', 'Risk management'], ['emotions', 'Emotions'], ['not_started', "I haven't started yet"] ], cols: 2 }
  ];

  var TRACKS = {
    consistency: ['Your First Trading Plan', 'Pre-trade analysis and a pre-trade checklist you run before every session. Consistency comes from a repeatable routine.'],
    discipline: ['Your First Trading Plan', 'Daily loss limits and a pre-trade checklist that keep you on your rules when it matters.'],
    strategy: ['Reading Charts', 'Swing points, gaps, and key levels first, then the Pullback Strategy lesson ties it into one complete setup.'],
    risk: ['Risk Management', 'Risk-reward, position size, and partial entries, worked through in ticks on MES. Futures are leveraged, so this comes first.'],
    emotions: ['Your First Trading Plan', 'Daily loss limits and a pre-trade checklist take the guesswork out of hard moments. Wins & Lessons Learned is where members talk it through.'],
    not_started: ['Market Fundamentals', 'What trading is, who is in the market, supply and demand, and support and resistance.']
  };

  var answers = {};
  var step = 0;
  var body = document.getElementById('quiz-body');
  var bar = document.getElementById('quiz-progress');
  var label = document.getElementById('quiz-step-label');
  var started = false;
  var signup = document.getElementById('quiz-signup');
  document.getElementById('quiz-change').addEventListener('click', function () {
    signup.hidden = true;
    window.MEF_EXTRA = null;
    step = QUESTIONS.length - 1;
    renderQuestion(true);
  });

  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function track(event, data) {
    // Picked up by Google Tag Manager. The signup itself is tracked by the form as free_member_signup.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: event }, data || {}));
  }

  function renderQuestion(focus) {
    var Q = QUESTIONS[step];
    label.textContent = 'Question ' + (step + 1) + ' of ' + QUESTIONS.length;
    bar.style.width = ((step + 1) / QUESTIONS.length * 100) + '%';
    var html = '<div class="step-anim"><h2 class="q-title" id="q-title" tabindex="-1">' + esc(Q.q) + '</h2>' +
      '<p class="q-hint">' + esc(Q.hint) + '</p><div class="options' + (Q.cols === 2 ? ' two' : '') + '" role="group" aria-labelledby="q-title">';
    Q.opts.forEach(function (o, i) {
      var sel = answers[Q.id] === o[0];
      html += '<button type="button" class="opt" id="opt-' + Q.id + '-' + o[0] + '" data-v="' + o[0] + '" aria-pressed="' + sel + '"><span class="key">' + String.fromCharCode(65 + i) + '</span>' + esc(o[1]) + '</button>';
    });
    html += '</div><div class="quiz-foot">' + (step > 0 ? '<button type="button" class="back" id="quiz-back">← Back</button>' : '<span>Free forever · No credit card</span>') +
      '<span>' + (step + 1) + '/' + QUESTIONS.length + '</span></div></div>';
    body.innerHTML = html;
    body.querySelectorAll('.opt').forEach(function (b) {
      b.addEventListener('click', function () { choose(Q, b); });
    });
    var back = document.getElementById('quiz-back');
    if (back) back.addEventListener('click', function () { step--; renderQuestion(true); });
    if (focus) document.getElementById('q-title').focus({ preventScroll: true });
  }

  function choose(Q, btn) {
    answers[Q.id] = btn.getAttribute('data-v');
    body.querySelectorAll('.opt').forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
    if (!started) { started = true; track('quiz_start'); }
    track('quiz_answer', { question: Q.id, answer: answers[Q.id] });
    setTimeout(function () {
      if (step < QUESTIONS.length - 1) { step++; renderQuestion(true); }
      else renderResult();
    }, 220);
  }

  function buildProfile(a) {
    var tried = a.prior_education !== 'none';
    var lowTime = a.training_time === 'under_2h' || a.trading_time === 'under_3h';
    var highTime = (a.training_time === '10h_plus' || a.training_time === '5_10h') && (a.trading_time === '8h_plus' || a.trading_time === '3_8h');
    var name, intro;
    if (!tried && a.biggest_struggle === 'not_started') { name = 'The Foundation Builder'; intro = "You're starting fresh, which is an advantage. You have no bad habits to unlearn."; }
    else if (!tried) { name = 'The Self-Taught Starter'; intro = "You've been figuring it out on your own. Structure and feedback will speed things up."; }
    else { name = 'The Rebuilder'; intro = "You've already invested in learning. What's usually missing is structure and accountability, and that's what the community is for."; }

    var pace;
    if (a.trading_time === 'not_yet') pace = "Focus on lessons first. You'll start sim trading once the foundations click.";
    else if (highTime) pace = 'You have time to move quickly: daily lessons, weekly prep, and sim reps most days.';
    else if (lowTime) pace = 'Your schedule fits a steady pace. One focused trading window and one or two lessons a week is enough to make progress.';
    else pace = 'You have room for a solid routine: a few lessons a week plus a set daily trading window.';

    var capital;
    if (a.capital_belief === '25k_plus') capital = "You don't need any money in a trading account to start learning. Members build and test their process in a simulator first.";
    else if (a.capital_belief === 'unsure') capital = "That's a common answer. You don't need a trading account to start learning. Members practice in a simulator first.";
    else capital = "You don't need a trading account to start learning. Members practice in a simulator first, so you can focus on the skill.";

    return { name: name, intro: intro, pace: pace, capital: capital, track: TRACKS[a.biggest_struggle] };
  }

  // The answer's wording as shown on the button (e.g. "2 to 5 hours"), so it reads well in Circle and the Sheet.
  function answerLabel(id) {
    var Q = QUESTIONS.filter(function (q) { return q.id === id; })[0];
    var o = Q && Q.opts.filter(function (opt) { return opt[0] === answers[id]; })[0];
    return o ? o[1] : (answers[id] || '');
  }

  function renderResult() {
    var p = buildProfile(answers);
    label.textContent = 'Your starting plan';
    bar.style.width = '100%';
    track('quiz_complete', { answers: answers, profile: p.name });
    body.innerHTML = '<div class="step-anim">' +
      '<div class="result-badge">● Plan ready</div>' +
      '<h2 class="q-title" id="q-title" tabindex="-1">You\'re ' + esc(p.name) + '.</h2>' +
      '<p class="q-hint" style="margin-bottom:0">' + esc(p.intro) + '</p>' +
      '<ul class="result-list">' +
        '<li><span class="ico-n">01</span><span><strong>Start with: ' + esc(p.track[0]) + '.</strong> ' + esc(p.track[1]) + '</span></li>' +
        '<li><span class="ico-n">02</span><span><strong>Your pace.</strong> ' + esc(p.pace) + '</span></li>' +
        '<li><span class="ico-n">03</span><span><strong>About getting started.</strong> ' + esc(p.capital) + '</span></li>' +
      '</ul>' +
    '</div>';
    document.getElementById('q-title').focus({ preventScroll: true });
    // Sent with the registration to the same Make.com scenario as the landing pages.
    window.MEF_EXTRA = {
      signup_source: 'homepage_quiz',
      quiz_profile: p.name,
      quiz_start_module: p.track[0],
      quiz_training_time: answerLabel('training_time'),
      quiz_trading_time: answerLabel('trading_time'),
      quiz_capital_belief: answerLabel('capital_belief'),
      quiz_prior_education: answerLabel('prior_education'),
      quiz_biggest_struggle: answerLabel('biggest_struggle')
    };
    signup.hidden = false;
  }

  renderQuestion(false);


})();
</script>
